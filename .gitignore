__pycache__/
*.pyc
.venv/
venv/
.venv-lean/
.venv-lean-install.log

# Local-only dev server config (machine-specific ports/paths); the
# deploy-verify agent recreates it when missing.
.claude/launch.json

# Per-session git worktrees, when more than one session is working at once
# (see docs/session_roles.md). Worth adding to .git/info/exclude too on a
# working machine: this line only protects a tree that already has this
# commit, and the main checkout may not yet.
.claude/worktrees/

# Per-city raw downloads and pipeline intermediates - regenerable, not
# committed (see docs/project_context.md, "Architecture").
data/*/raw/
data/*/processed/
# A folder in data/ whose name starts with "_" is local-only: a session's
# durable scratch copy, for example data/_staging_scratch_2026-09-27/ (285 MB
# of licence pages and API captures). Found untracked, and not ignored, in four
# checkouts on 2026-09-27, one `git add -A` away from being committed.
data/_*/

# outputs/<city>/ IS committed - the deployed app only ever reads from
# there, per the pipeline/app split.

# Local-only working notes (session logs, scratch write-ups). This repo is
# public, so anything that is not meant to be published gets this suffix
# rather than relying on nobody running `git add .` - a broad add once swept
# an unreviewed file into a public commit.
*.local.md

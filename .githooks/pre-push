#!/bin/sh
# Refuse a push while any pass/fail check fails. See scripts/check_all.py.
# Enabled once per clone: git config core.hooksPath .githooks
# A worktree whose branch predates this file simply has no hook.
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: running scripts/check_all.py (about 30s)"
exec python scripts/check_all.py

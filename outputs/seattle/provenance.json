      "endpoint": "https://data.kingcounty.gov/resource/r878-4sxa.csv",
      "query": {
        "$limit": "500000",
        "$order": "business_id,inspection_date,inspection_serial_num",
        "$select": "business_id,name,program_identifier,classification,seating_range,risk_category,address,city,zip_code,parcel_number,inspection_date,inspection_type,inspection_closed_business,inspection_serial_num"
      }
    },
